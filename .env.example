# CampusBid Environment Configuration

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Gemini API Key for AI Campus Assistant
# Note: In production, access the Gemini API via a secure server-side endpoint or Supabase Edge Function
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Campus Configuration
# Set your institution's email domain restriction (e.g., bit.edu, iitb.ac.in, campus.edu)
VITE_CAMPUS_DOMAIN=bit.edu
VITE_CAMPUS_NAME=Birla Institute of Technology
